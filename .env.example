# Google Gemini API Key (Required for video analysis & speech transcription)
GEMINI_API_KEY=your_gemini_api_key_here

# Access Passcode for Savyor
# If left blank or unset, server binds strictly to 127.0.0.1 (localhost only).
# When set, enables signed HttpOnly session cookies (30-day expiry) and rate-limiting.
SAVYOR_PASSCODE=your_passcode_here

# Session signing secret key (Required if SAVYOR_PASSCODE is set; cannot be the old default)
SAVYOR_SECRET_KEY=generate_a_secure_random_secret_here

# Allowed CORS Origins (comma-separated, without wildcards for credentials support)
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000

# Optional custom data directory for SQLite database and media (videos/thumbs)
# When set, reels.db, media/videos, and media/thumbs live inside this folder.
# SAVYOR_DATA_DIR=/app/data
